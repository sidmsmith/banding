{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/manhattan-logo.png",
      "dest": "/manhattan-logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
